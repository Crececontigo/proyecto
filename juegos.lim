              <filas>4</filas>
              <columnas>4</columnas>
              <reixa>0</reixa>
            <forma>0</forma>
        </paxina>
        <paxina id="5" >
              <tipo>36</tipo>
              <cabeceira>Observa el dibujo del lado izquierdo. Usa los colores para repetir la imagen exactamente igual. </cabeceira>
              <pe>¡Hazlo rápido y con precisión!</pe>
              <forma>0</forma>
              <valor>1</valor>
        </paxina>
        <paxina id="6" >
              <tipo>51</tipo>
              <cabeceira>Dale clicka la imagen, visualiza la ubicacion y selecciona las que sean iguales</cabeceira>
              <valor>6</valor>
              <peza imaxe="integradocmp.jpg">1</peza>
              <peza imaxe="sena.png">2</peza>
              <modo>1</modo>
        </paxina>
        <paxina id="7" >
              <tipo>17</tipo>
              <cabeceira>Encuentra los pares antes de que se acabe el tiempo</cabeceira>
              <parellas>sena.png</parellas>
              <parellas>logocmp.png</parellas>
              <parellas>corazon.jpg</parellas>
