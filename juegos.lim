              <parellas>amorpp.jpg</parellas>
              <parellas>corazon.jpg</parellas>
              <parellas>sena.png</parellas>
              <parellas>logocmp.png</parellas>
              <parellas>fuerza.png</parellas>
              <cfondo>FFFFFF</cfondo>
              <ctapa>000000</ctapa>
